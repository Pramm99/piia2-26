# Claves de los planes gratuitos de los modelos (ADR-005). Copia este fichero como .env (no se sube al
# repo) y rellena las que vayas a usar. Las variables de entorno del sistema tienen prioridad.
#   Cerebras: https://cloud.cerebras.ai  (modelo principal: gpt-oss-120b)
#   Groq:     https://console.groq.com   (modelo secundario: qwen/qwen3.8-27b; respaldo gpt-oss-120b)
#   Gemini:   https://aistudio.google.com (opcional, referencia; su cuota diaria se ve en AI Studio)
# Ollama (local) no necesita clave.
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Opcional (Fase 1): sube el límite de NCBI E-utilities a 10 peticiones/s
NCBI_API_KEY=
