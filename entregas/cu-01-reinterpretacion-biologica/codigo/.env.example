# Claves de los planes gratuitos y datos de contacto. Copia este fichero como .env (no se sube al repo:
# está en .gitignore) y rellena las que vayas a usar. Las variables de entorno del sistema tienen prioridad.
# Las leen la Fase 2 (fase2_inferencia/cliente.py) y la Fase 1 (fase1_ingesta/config.py), también cuando las
# lanza el puente de la Fase 4 (fase4_frontend/api_puente.py). La interfaz React no necesita ninguna variable.
#   Gemini: https://aistudio.google.com  (modelo principal: gemini-3.5-flash-lite; su cuota se ve en AI Studio)
#   Groq:   https://console.groq.com     (modelo secundario: openai/gpt-oss-120b)
#   Cerebras: https://cloud.cerebras.ai  (opcional, sin usar: gpt-oss-120b)
# Ollama (local) no necesita clave.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Fase 1, NCBI E-utilities: correo de contacto (buena práctica de NCBI) y clave opcional, que sube el
# límite a 10 peticiones/s
NCBI_EMAIL=
NCBI_API_KEY=
